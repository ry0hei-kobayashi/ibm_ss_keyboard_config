{
  "title": "macOS IBM Space Saver Keyboard II TrackPoint Scroll",
  "rules": [
    {
      "description": "macOS: Use middle button + TrackPoint movement as 
scroll",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "pointing_button": "button3",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "ibm_space_saver_trackpoint_scroll_mac",
                "value": true,
                "key_up_value": false
              }
            }
          ]
        },
        {
          "type": "mouse_motion_to_scroll",
          "from": {
            "modifiers": {
              "optional": ["any"]
            }
          },
          "conditions": [
            {
              "type": "variable_if",
              "name": "ibm_space_saver_trackpoint_scroll_mac",
              "value": true
            }
          ],
          "options": {
            "momentum_scroll_enabled": false,
            "speed_multiplier": 1.0
          }
        }
      ]
    }
  ]
}
